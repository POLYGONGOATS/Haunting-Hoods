rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /bug_reports/{document=**} {
      allow read: if false;
      allow create: if 
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.description.size() <= 5000 &&
        
        request.resource.data.consoleLogs is list &&
        
        request.resource.data.deviceInfo is map &&
        request.resource.data.deviceInfo.type in ['Desktop', 'Browser', 'Electron'] &&
        
        (!('url' in request.resource.data.deviceInfo) || 
         request.resource.data.deviceInfo.url is string) &&
        
        request.resource.data.createdAt == request.time;
        
      allow update, delete: if false;
    }
    
    match /guestbook/{entry} {
      allow read: if true;
      
      allow create: if 
        request.resource.data.playerName is string &&
        request.resource.data.playerName.size() >= 2 &&
        request.resource.data.playerName.size() <= 30 &&
        
        request.resource.data.playerName.matches('^[a-zA-Z0-9\\s._-]+$') &&
        
        request.resource.data.startTime is number &&
        request.resource.data.endTime is number &&
        request.resource.data.endTime > request.resource.data.startTime &&
        
        (request.resource.data.endTime - request.resource.data.startTime) >= 0 &&
        (request.resource.data.endTime - request.resource.data.startTime) <= 604800000 &&
        
        request.resource.data.createdAt == request.time;
        
      allow update: if false;
      allow delete: if false;
    }
    
    match /guestbook_zh/{entry} {
      allow read: if true;

      allow create: if
        request.resource.data.playerName is string &&
        request.resource.data.playerName.size() >= 2 &&
        request.resource.data.playerName.size() <= 30 &&

        request.resource.data.playerName.matches('^[\\p{L}\\p{N}\\p{P}\\p{S}\\p{Zs}]+$') &&

        request.resource.data.startTime is number &&
        request.resource.data.endTime is number &&
        request.resource.data.endTime > request.resource.data.startTime &&

        (request.resource.data.endTime - request.resource.data.startTime) >= 0 &&
        (request.resource.data.endTime - request.resource.data.startTime) <= 604800000 &&

        request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if false;
    }

    match /guestbook_zh_debug/{entry} {
      allow read: if true;

      allow create: if
        request.resource.data.playerName is string &&
        request.resource.data.playerName.size() >= 2 &&
        request.resource.data.playerName.size() <= 30 &&

        request.resource.data.playerName.matches('^[\\p{L}\\p{N}\\p{P}\\p{S}\\p{Zs}]+$') &&

        request.resource.data.startTime is number &&
        request.resource.data.endTime is number &&
        request.resource.data.endTime > request.resource.data.startTime &&

        (request.resource.data.endTime - request.resource.data.startTime) >= 0 &&
        (request.resource.data.endTime - request.resource.data.startTime) <= 604800000 &&

        request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if false;
    }

    match /guestbook_debug/{entry} {
      allow read: if true;
      
      allow create: if 
        request.resource.data.playerName is string &&
        request.resource.data.playerName.size() >= 2 &&
        request.resource.data.playerName.size() <= 30 &&
        
        request.resource.data.playerName.matches('^[a-zA-Z0-9\\s._-]+$') &&
        
        request.resource.data.startTime is number &&
        request.resource.data.endTime is number &&
        request.resource.data.endTime > request.resource.data.startTime &&
        
        (request.resource.data.endTime - request.resource.data.startTime) >= 0 &&
        (request.resource.data.endTime - request.resource.data.startTime) <= 604800000 &&
        
        request.resource.data.createdAt == request.time;
        
      allow update: if false;
      allow delete: if false;
    }

    // Daily whitelist hunt campaigns: created/managed by admins only (via
    // console/admin SDK). Clients may only read the active campaign to show
    // slots remaining; claimedCount updates happen only via the transaction
    // performed against whitelist_claims below.
    match /whitelist_campaigns/{campaignId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['claimedCount']) &&
        request.resource.data.claimedCount == resource.data.claimedCount + 1 &&
        request.resource.data.claimedCount <= resource.data.slotsTotal &&
        resource.data.active == true;
    }

    // One claim document per authenticated user (document id == uid), so a
    // user can never claim more than once, enforced server-side.
    match /whitelist_claims/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if
        request.auth != null &&
        request.auth.uid == uid &&
        request.auth.token.firebase.sign_in_provider == 'twitter.com' &&
        request.time >= request.auth.token.auth_time + duration.value(60, 's') &&
        request.resource.data.uid == uid &&
        request.resource.data.walletAddress is string &&
        request.resource.data.walletAddress.size() > 0 &&
        request.resource.data.quoteTweetLink is string &&
        request.resource.data.quoteTweetLink.matches('^https://(x|twitter)\\.com/.*') &&
        request.resource.data.campaignId is string &&
        request.resource.data.claimNumber is number &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

  }
}